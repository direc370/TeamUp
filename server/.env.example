# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection string. `prisma generate` does not connect to it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# HS256 JWT secret used by the replaceable authenticator. Use a long random value.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
