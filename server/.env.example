# PORT 缺省为 3000，仅允许整数 1..65535。
# NODE_ENV 缺省为 development，仅允许 development/test/production。
PORT=3000
NODE_ENV=development
# 多个 origin 以逗号分隔；仅允许 http(s)://host[:port]，不带末尾斜杠。
# 禁止凭据、路径、查询、fragment、通配符及空条目。
CORS_ORIGINS=http://localhost:5173

# 必须使用 postgres/postgresql URL 并提供 host 与数据库名。
# 此处仅为占位符；prisma generate 不连接数据库。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# HS256 JWT 密钥至少 32 个字符，请替换为随机值；下方占位符会导致启动失败。
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# 可选。签发方与受众，缺省分别为 saiban / saiban-api。
# JWT_ISSUER=saiban
# JWT_AUDIENCE=saiban-api
