# 所有 VITE_* 变量会公开到浏览器；不得放入密码、私钥或 service_role 等秘密
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# 三种 provider：local 本地演示 | supabase 直连 Supabase | api 请求后端 API
# 留空时保持自动选择 Supabase 或本地演示
# api 模式使用自有登录（POST /auth/register|login|logout|refresh），会话保存在 localStorage saiban:api-session，不再使用 Supabase session
VITE_DATA_PROVIDER=
# API 地址必须为绝对 HTTP(S) URL，不得包含用户名密码、查询参数或片段
# API 模式示例：http://localhost:3000/api/v1/；请求端点限制在此源及路径前缀内
# Pages/Vite 的 base 是前端静态资源部署路径，不是 API 地址
VITE_API_BASE_URL=
